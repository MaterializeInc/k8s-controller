{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>MaterializeInc/renovate-config", "schedule:weekly"],
  "labels": ["A-dependencies"],
  "packageRules": [
    {
      "description": "rust-version is the published MSRV, so it and the CI toolchain are raised by hand rather than following the latest Rust.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "enabled": false
    }
  ],
  "reviewers": ["team:dependency-czars"],
  "constraints": {
    "rust": "1.89.0"
  }
}
